                <ResourceDictionary Source="/Style/ComboBoxDict.xaml"/>
                <ResourceDictionary Source="/Style/ErrorEvent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
