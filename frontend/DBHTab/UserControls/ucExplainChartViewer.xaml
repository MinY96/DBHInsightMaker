<UserControl x:Class="DBHTab.UserControls.ucExplainChartViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DBHTab.UserControls"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             mc:Ignorable="d" 
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:c="clr-namespace:DBHTab.Converters">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <ui:SimpleStackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Orientation="Horizontal" Spacing="10">
            <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}" Margin="10,0,0,0"
               Text="{Binding Path=ChartName, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Center"/>
            <Button VerticalAlignment="Center" Content="차트 저장" Command="{Binding Path=SaveChartImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiParaConverter}">
                        <Binding Path="ChartPath" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        <Binding Path="ChartImage" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    </MultiBinding>
                </Button.CommandParameter>
            </Button>
        </ui:SimpleStackPanel>
        <Border Grid.Row="1" Grid.Column="0"
            Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Margin="10,0,0,0" Padding="10">
            <Image x:Name="imgChart"
           Source="{Binding Path=ChartImage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullImageConverter}}"
           Stretch="Uniform"/>
        </Border>
        <Grid Grid.Row="1" Grid.Column="1" Background="AliceBlue">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="1.7*"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="1.5*"/>
            </Grid.RowDefinitions>
            <emoji:TextBlock Grid.Row="0" Text="📝 설명" FontSize="15"/>
            <emoji:TextBlock Grid.Row="2" Text="💡 인사이트" FontSize="15"/>
            <emoji:TextBlock Grid.Row="4" Text="📌 체크포인트" FontSize="15"/>
            <TextBlock x:Name="txtExplain" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" FontStyle="Italic" TextWrapping="Wrap"
                       Text="{Binding Path=Explain, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <TextBlock x:Name="txtInsight" Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Top" FontStyle="Italic" TextWrapping="Wrap"
                       Text="{Binding Path=Insight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <TextBlock x:Name="txtCheck" Grid.Row="5" HorizontalAlignment="Stretch" VerticalAlignment="Top" FontStyle="Italic" TextWrapping="Wrap"
                       Text="{Binding Path=CheckPoint, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Grid>
    </Grid>
</UserControl>
