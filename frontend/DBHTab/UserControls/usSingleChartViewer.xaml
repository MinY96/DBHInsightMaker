<UserControl x:Class="DBHTab.UserControls.usSingleChartViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DBHTab.UserControls"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:animatedGif="http://wpfanimatedgif.codeplex.com"
             xmlns:c="clr-namespace:DBHTab.Converters"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:SimpleStackPanel Grid.Row="0" HorizontalAlignment="Stretch" Orientation="Horizontal" Spacing="10">
            <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}" Margin="10,0,0,0"
                       Text="{Binding Path=ChartName, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Center"/>
            <Button VerticalAlignment="Center" Content="차트 저장" Command="{Binding Path=SaveChartImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiParaConverter}">
                        <Binding Path="ChartPath" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        <Binding Path="ChartImage" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    </MultiBinding>
                </Button.CommandParameter>
            </Button>
        </ui:SimpleStackPanel>
        <Border Grid.Row="1"
                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="10,0,10,0" Padding="10">
            <Image x:Name="imgChart"                   
                   Stretch="Uniform">
                <Image.Style>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="animatedGif:ImageBehavior.AnimatedSource"
                                Value="{Binding Path=ChartImage,
                            RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullImageConverter}}"/>
                    </Style>
                </Image.Style>
            </Image>
        </Border>
    </Grid>
</UserControl>
