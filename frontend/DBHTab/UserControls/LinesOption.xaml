<UserControl x:Class="DBHTab.UserControls.LinesOption"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:c="clr-namespace:DBHTab.Models"
             xmlns:local="clr-namespace:DBHTab.UserControls"
             mc:Ignorable="d">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,5">
            <TextBlock Text="선 추가" VerticalAlignment="Center" Margin="0,0,0,0"/>
            <Button Content="추가" Margin="10,0,0,0" Padding="10,2" Click="AddLine_Click" VerticalAlignment="Center"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Lines, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type c:ChartLineOption}">
                        <Border BorderThickness="1" BorderBrush="#DDD" Background="#DDD" Margin="5" Padding="5">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="방향" Margin="0,0,0,3" VerticalAlignment="Center"/>
                                        <ComboBox Width="360" Margin="0,0,5,0"       
                                                    x:Name="cmbLineAxis"
                                            SelectedValue="{Binding Axis, Mode=TwoWay,
                                            Converter={StaticResource ChartOptionStringToComboBoxItemConverter}, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="수평"/>
                                            <ComboBoxItem Content="수직"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <Button Content="삭제" Margin="5,0,0,0" Click="RemoveButton_Click"/>
                                </StackPanel>
                                <Expander Header="선 추가 옵션" IsExpanded="True" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="종류" Margin="0,0,0,3" VerticalAlignment="Center"/>
                                                <ComboBox 
                                                    Width="360" Margin="0,0,5,0" 
                                                    SelectedValue="{Binding Kind, Mode=TwoWay, Converter={StaticResource ChartOptionStringToComboBoxItemConverter}, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBoxItem Content="최대값"/>
                                                    <ComboBoxItem Content="최소값"/>
                                                    <ComboBoxItem Content="평균값"/>
                                                    <ComboBoxItem Content="중앙값"/>
                                                    <ComboBoxItem Content="μ+1σ"/>
                                                    <ComboBoxItem Content="μ+2σ"/>
                                                    <ComboBoxItem Content="μ+3σ"/>
                                                    <ComboBoxItem Content="μ-1σ"/>
                                                    <ComboBoxItem Content="μ-2σ"/>
                                                    <ComboBoxItem Content="μ-3σ"/>
                                                    <ComboBoxItem Content="최대값 인덱스(최초)"/>
                                                    <ComboBoxItem Content="최대값 인덱스(전체)"/>
                                                    <ComboBoxItem Content="최소값 인덱스(최초)"/>
                                                    <ComboBoxItem Content="최소값 인덱스(전체)"/>
                                                    <ComboBoxItem Content="사용자 지정"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                                            <ui:ToggleSwitch x:Name="toggleCustomType" Header="값 타입" Width="120"
                                                OffContent="DateTime" OnContent="실수" IsOn="{Binding IsCustomValueDouble}" />
                                            <StackPanel Orientation="Vertical" IsEnabled="{Binding ElementName=toggleCustomType, Path=IsOn}">
                                                <TextBlock Text="사용자 지정 값" Margin="0,0,0,3" VerticalAlignment="Center"/>
                                                <xctk:DoubleUpDown Width="120" Margin="0,0,5,0" VerticalAlignment="Stretch"
                                                                Value="{Binding CustomValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Vertical" IsEnabled="{Binding ElementName=toggleCustomType, Path=IsOn, Converter={StaticResource AnalyzeStateConverter}}">
                                                <TextBlock Text="사용자 지정 값(DateTime)" Margin="0,0,0,3" VerticalAlignment="Center"/>
                                                <xctk:DateTimePicker Width="180" Margin="0,0,5,0" VerticalAlignment="Stretch"
                                                            Format="Custom" FormatString="yyyy-MM-dd HH:mm:ss"
                                                            Value="{Binding CustomDateTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,
                                                                    Converter={StaticResource ChartOptionStringToDateTimeConverter},
                                                                    ConverterParameter='yyyy-MM-dd HH:mm:ss'}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="라인 스타일" Margin="0,0,0,3" VerticalAlignment="Center"/>
                                                <ComboBox Width="120" Margin="0,0,5,0"
                                                    SelectedValue="{Binding LineStyle, Mode=TwoWay, Converter={StaticResource ChartOptionStringToComboBoxItemConverter}, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBoxItem Content="solid"/>
                                                    <ComboBoxItem Content="dotted"/>
                                                    <ComboBoxItem Content="dashed"/>
                                                    <ComboBoxItem Content="dashdot"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="라인 두께" Margin="0,0,0,3" VerticalAlignment="Center"/>
                                                <xctk:IntegerUpDown Margin="0,0,5,0" Width="120" Minimum="1" FormatString="N0" Increment="1" 
                                                                    Value="{Binding LineWidth, Mode=TwoWay, Converter={StaticResource ChartOptionStringToNullableIntConverter}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="라인 색상" Margin="0,0,0,3" VerticalAlignment="Center"/>
                                                <xctk:ColorPicker Width="120" Margin="0,0,5,0" VerticalAlignment="Stretch"                                                      
                                                                SelectedColor="{Binding Color, Converter={StaticResource ChartOptionStringToColorConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="텍스트 표시" Margin="0,0,0,3" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="360"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="텍스트 수직 정렬" Margin="0,0,0,3" VerticalAlignment="Center"/>
                                                <ComboBox Width="120" Margin="0,0,5,0"
                                                    SelectedValue="{Binding TextAlignVertical, Mode=TwoWay, Converter={StaticResource ChartOptionStringToComboBoxItemConverter}, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBoxItem Content="center"/>
                                                    <ComboBoxItem Content="top"/>
                                                    <ComboBoxItem Content="bottom"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="텍스트 수평 정렬" Margin="0,0,0,3" VerticalAlignment="Center"/>
                                                <ComboBox Width="120" Margin="0,0,5,0"
                                                    SelectedValue="{Binding TextAlignHorizontal, Mode=TwoWay, Converter={StaticResource ChartOptionStringToComboBoxItemConverter}, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBoxItem Content="center"/>
                                                    <ComboBoxItem Content="left"/>
                                                    <ComboBoxItem Content="right"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="텍스트 회전" Margin="0,0,0,3" VerticalAlignment="Center"/>
                                                <xctk:IntegerUpDown Margin="0,0,5,0" Width="120" Minimum="1" FormatString="N0" Increment="1" 
                                                    Value="{Binding TextRotation, Mode=TwoWay, Converter={StaticResource ChartOptionStringToNullableIntConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
