<ui:Page x:Class="DBHTab.Pages.CreateRandomColPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:DBHTab.Converters"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:local="clr-namespace:DBHTab.Pages"
      mc:Ignorable="d">

    <ui:ScrollViewerEx>
        <ui:SimpleStackPanel Background="{DynamicResource ApplicationPageBackgroudThemeBrush}"
                             Spacing="10" Margin="10">
            <ui:NumberBox Header="최소" SpinButtonPlacementMode="Inline" SmallChange="0.01" Value="{Binding MinValue, Converter={StaticResource StringToFloatConverter}}"/>
            <ui:NumberBox Header="최대" SpinButtonPlacementMode="Inline" SmallChange="0.01" Value="{Binding MaxValue, Converter={StaticResource StringToFloatConverter}}"/>
            <ui:RadioButtons ui:ControlHelper.Header="숫자 타입" MaxColumns="2">
                <RadioButton Content="정수" IsChecked="{Binding IsInteger}"/>
                <RadioButton Content="실수"/>
            </ui:RadioButtons>
            <CheckBox x:Name="chkSetUniform" Content="정규 분포" IsChecked="{Binding SetNormalDist}"/>
            <Border BorderThickness="2" BorderBrush="LightGray" Padding="10" Margin="0,-5,0,0"
                    Visibility="{Binding ElementName=chkSetUniform, Path=IsChecked, Converter={StaticResource CheckBoxToVisibilityConverter}}">
                <ui:SimpleStackPanel>
                    <ui:NumberBox Header="평균" SpinButtonPlacementMode="Inline" SmallChange="0.01" Value="{Binding MeanValue, Converter={StaticResource StringToFloatConverter}}"/>
                    <ui:NumberBox Header="표준편차" SpinButtonPlacementMode="Inline" SmallChange="0.01" Value="{Binding StdValue, Converter={StaticResource StringToFloatConverter}}"/>
                </ui:SimpleStackPanel>
            </Border>
        </ui:SimpleStackPanel>
    </ui:ScrollViewerEx>
</ui:Page>
