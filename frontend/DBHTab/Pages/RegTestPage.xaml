<ui:Page x:Class="DBHTab.Pages.RegTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:c="clr-namespace:DBHTab.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DBHTab.Pages"
      mc:Ignorable="d" 
      xmlns:ui="http://schemas.modernwpf.com/2019">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
            Style="{StaticResource HeaderTextBlockStyle}" 
            FontSize="35"
            Text="모델 테스트" VerticalAlignment="Center"/>
        <Grid Grid.Row="1" Grid.Column="0" Margin="-10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
           Style="{DynamicResource SubtitleTextBlockStyle}"
           Margin="10,0,0,0" Text="테스트 성과 지표" VerticalAlignment="Center"/>
            <Border Grid.Row="1"
                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="10,0,0,0" Padding="10">
                <DataGrid x:Name="testPerformanceGrid"
                  Grid.Row="3" Grid.Column="0"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"   
                  CanUserReorderColumns="False" 
                  AlternatingRowBackground="AliceBlue"
                  Margin="0,0,0,10"/>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
               Style="{DynamicResource SubtitleTextBlockStyle}"
               Margin="10,0,0,0" Text="테스트 결과" VerticalAlignment="Center"/>
            <Border Grid.Row="1"
                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="10,0,0,0" Padding="10">
                <DataGrid x:Name="testResultGrid"
                    Grid.Row="3" Grid.Column="1"
                    AutoGenerateColumns="True"
                    IsReadOnly="True"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal"   
                    CanUserReorderColumns="False" 
                    AlternatingRowBackground="AliceBlue"
                    Margin="0,0,10,0"/>
            </Border>
        </Grid>
        <Grid x:Name="grdTestPlot" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="-10,10,-10,0"/>
    </Grid>
</ui:Page>
