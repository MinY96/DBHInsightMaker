<ui:Page x:Class="DBHTab.Pages.RegCorrPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:c="clr-namespace:DBHTab.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DBHTab.Pages"
      xmlns:uc="clr-namespace:DBHTab.UserControls"
      mc:Ignorable="d"       
      xmlns:ui="http://schemas.modernwpf.com/2019">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
            Style="{StaticResource HeaderTextBlockStyle}" 
            FontSize="35"
            Text="독립 변수 검정" VerticalAlignment="Center"/>
        <ui:ScrollViewerEx Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Margin="-10,0,0,0">
            <uc:usSingleChartViewer x:Name="cvScatterMatrix"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        ChartName="독립 변수 산점도 행렬"/>
        </ui:ScrollViewerEx>
        <ui:ScrollViewerEx Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="-10,0,0,0">
            <ui:SimpleStackPanel>
                <uc:usSingleChartViewer x:Name="cvCorrMatrix"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ChartName="독립 변수 상관 계수 행렬(Pearson)"/>
                <Border Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Margin="10,10,10,10" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="독립 변수 상관 계수 상세" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                        <DataGrid Grid.Row="1"
                            MaxHeight="500"
                            x:Name="CorrResultsGrid"
                            AutoGenerateColumns="True"
                            HeadersVisibility="Column" GridLinesVisibility="Horizontal"   
                            CanUserReorderColumns="False" 
                            IsReadOnly="True"
                            AlternatingRowBackground="AliceBlue"/>
                    </Grid>
                </Border>
            </ui:SimpleStackPanel>
        </ui:ScrollViewerEx>
        <ui:ScrollViewerEx Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Margin="0,0,-10,0">
            <ui:SimpleStackPanel>
                <uc:usSingleChartViewer x:Name="cvVifScore"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ChartName="분산 팽창 계수(VIF)"/>
            </ui:SimpleStackPanel>
        </ui:ScrollViewerEx>
    </Grid>
</ui:Page>