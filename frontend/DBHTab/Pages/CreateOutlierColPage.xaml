<ui:Page x:Class="DBHTab.Pages.CreateOutlierColPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:DBHTab.Converters"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:local="clr-namespace:DBHTab.Pages"
      mc:Ignorable="d">

    <ui:ScrollViewerEx>
        <ui:SimpleStackPanel Background="{DynamicResource ApplicationPageBackgroudThemeBrush}"
             Spacing="10" Margin="10">
            <ui:SimpleStackPanel Spacing="10">
                <ComboBox 
                    ui:ControlHelper.Header="적용할 데이터"
                    ui:ControlHelper.PlaceholderText="수치형 데이터"
                    ItemTemplate="{StaticResource ColumnComboHideItem}"
                    ItemsSource="{Binding Path=NumericalColumns}"
                    SelectedItem="{Binding Path=SelectedColumn}"/>
                <ui:RadioButtons ui:ControlHelper.Header="이상치 탐지 기법"
                    x:Name="rdoOutlierType" MaxColumns="2" SelectedIndex="0" SelectionChanged="rdoOutlierType_SelectionChanged">
                    <RadioButton Content="Sigma"/>
                    <RadioButton Content="IQR"/>
                </ui:RadioButtons>
                <Border BorderThickness="2" BorderBrush="LightGray" Padding="10" Margin="0,-5,0,0">
                    <ui:SimpleStackPanel Spacing="10">
                        <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                            <ui:SimpleStackPanel.Style>
                                <Style TargetType="ui:SimpleStackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=SelectedIndex, ElementName=rdoOutlierType}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SimpleStackPanel.Style>
                            <ui:NumberBox ui:ControlHelper.Header="이상치 Sigma 수준"                                          
                                      PlaceholderText="값" SpinButtonPlacementMode="Inline" Minimum="1" Value="{Binding SigmaLevel}" SmallChange="1"/>
                        </ui:SimpleStackPanel>
                        <ComboBox 
                            ui:ControlHelper.Header="이상치 대체 Method"
                            ui:ControlHelper.PlaceholderText="대체 Method" x:Name="cmbReplaceOutlierMethod"
                            HorizontalAlignment="Stretch" SelectedIndex="0" ItemTemplate="{StaticResource CreateNewColComboItem}"
                            SelectedItem="{Binding Path=Calc}"/>
                        <ui:SimpleStackPanel Spacing="10">
                            <ui:SimpleStackPanel.Style>
                                <Style TargetType="ui:SimpleStackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=SelectedIndex, ElementName=cmbReplaceOutlierMethod}" Value="7">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SimpleStackPanel.Style>
                            <ui:NumberBox PlaceholderText="대체할 값" SpinButtonPlacementMode="Inline" SmallChange="0.01" Value="{Binding ReplaceFixValue}"/>
                        </ui:SimpleStackPanel>

                    </ui:SimpleStackPanel>
                </Border>
            </ui:SimpleStackPanel>
        </ui:SimpleStackPanel>
    </ui:ScrollViewerEx>
</ui:Page>
