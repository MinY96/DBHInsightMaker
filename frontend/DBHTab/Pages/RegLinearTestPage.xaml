<Page x:Class="DBHTab.Pages.RegLinearTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
     xmlns:c="clr-namespace:DBHTab.Converters"
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
     xmlns:local="clr-namespace:DBHTab.Pages"
     xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
     xmlns:uc="clr-namespace:DBHTab.UserControls"
     mc:Ignorable="d" 
     xmlns:ui="http://schemas.modernwpf.com/2019">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
            Style="{StaticResource HeaderTextBlockStyle}" 
            FontSize="35" Text="모델 테스트" VerticalAlignment="Center"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="5" Padding="5">
                <Border Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <emoji:TextBlock Grid.Row="0" Text="📰 훈련 모델 정보" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                        <ui:ScrollViewerEx Grid.Row="1" 
                                       VerticalScrollBarVisibility="auto" 
                                       VerticalAlignment="Stretch"
                                       HorizontalScrollBarVisibility="Auto">
                            <ui:SimpleStackPanel Spacing="15" Margin="10,0,0,0" DataContext="{Binding LinearModelInfo}">
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- 회귀 모델 타입 : "/>
                                    <TextBlock Text="{Binding ModelType, UpdateSourceTrigger=PropertyChanged}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- 회귀식 : "/>
                                    <TextBlock Text="{Binding RegEquation, UpdateSourceTrigger=PropertyChanged}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- 훈련 데이터 크기 : "/>
                                    <TextBlock Text="{Binding DataSize, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- 특징 수 (k) : "/>
                                    <TextBlock Text="{Binding IndepValCount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- F-statistic (F통계량) : "/>
                                    <TextBlock Text="{Binding Statistic, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- p-value : "/>
                                    <TextBlock Text="{Binding PValue, UpdateSourceTrigger=PropertyChanged, StringFormat=E2}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- R² (결정 계수) : "/>
                                    <TextBlock Text="{Binding RSquare, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- R² adj (조정 결정 계수) : "/>
                                    <TextBlock Text="{Binding RSquareAdj, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- LLF (Log-Likelihood Function) : "/>
                                    <TextBlock Text="{Binding LLF, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- AIC (Akaike Information Criterion) : "/>
                                    <TextBlock Text="{Binding AIC, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- BIC (Bayesian Information Criterion) : "/>
                                    <TextBlock Text="{Binding BIC, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </ui:SimpleStackPanel>
                            </ui:SimpleStackPanel>
                        </ui:ScrollViewerEx>
                    </Grid>
                </Border>
            </Border>
            <Border Grid.Column="1"
                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="5" Padding="5">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,2,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <emoji:TextBlock Grid.Row="0" Text="📰 테스트 데이터 정보" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                            <ui:ScrollViewerEx Grid.Row="1" 
                                       VerticalScrollBarVisibility="auto" 
                                       VerticalAlignment="Stretch"
                                       HorizontalScrollBarVisibility="Auto">
                                <ui:SimpleStackPanel Spacing="15" Margin="10,0,0,0" DataContext="{Binding TestResult}">
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- 테스트 데이터 비율 : "/>
                                        <TextBlock Text="{Binding DataRatio, UpdateSourceTrigger=PropertyChanged, StringFormat=P2}"/>
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- 테스트 데이터 크기 : "/>
                                        <TextBlock Text="{Binding DataSize, UpdateSourceTrigger=PropertyChanged}"/>
                                    </ui:SimpleStackPanel>
                                </ui:SimpleStackPanel>
                            </ui:ScrollViewerEx>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1">
                        <Grid Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <emoji:TextBlock Grid.Row="0" Text="🔍 변동성 및 분산 지표" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                            <ui:ScrollViewerEx Grid.Row="1" VerticalScrollBarVisibility="auto"
                                           VerticalAlignment="Stretch"
                                           HorizontalScrollBarVisibility="Auto">
                                <ui:SimpleStackPanel Spacing="15" Margin="10,0,0,0" DataContext="{Binding TestResult}">
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- SST (Total Sum of Squares) : "/>
                                        <TextBlock Text="{Binding SST, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- SSR (Regression Sum of Squares) : "/>
                                        <TextBlock Text="{Binding SSR, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- SSE (Error Sum of Squares) : "/>
                                        <TextBlock Text="{Binding SSE, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                    </ui:SimpleStackPanel>
                                </ui:SimpleStackPanel>
                            </ui:ScrollViewerEx>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="5" Padding="5">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,2,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <emoji:TextBlock Grid.Row="0" Text="📰 테스트셋 적용 결과 테이블" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                            <DataGrid x:Name="RegTable" Grid.Row="1"
                                ItemsSource="{Binding RegTable}"
                                AutoGenerateColumns="True"
                                IsReadOnly="True"
                                HeadersVisibility="Column" GridLinesVisibility="Horizontal"   
                                CanUserReorderColumns="False"    
                                AlternatingRowBackground="AliceBlue"
                                Margin="0,0,10,0"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1">
                        <Grid Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <emoji:TextBlock Grid.Row="0" Text="🎯 오차 및 정확도 지표" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                    Background="SkyBlue" BorderBrush="DarkBlue" Width="30" Height="30" Margin="0,-10,0,0">
                                <emoji:TextBlock Text="❔" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                            </Button>
                            <ui:ScrollViewerEx Grid.Row="1" VerticalScrollBarVisibility="auto"
                                   VerticalAlignment="Stretch"
                                   HorizontalScrollBarVisibility="Auto">
                                <ui:SimpleStackPanel Spacing="15" Margin="10,0,0,0" DataContext="{Binding TestResult}">
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- R² (결정 계수) : "/>
                                        <TextBlock Text="{Binding RSquare, UpdateSourceTrigger=PropertyChanged, StringFormat=N4}"/>
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- R² adj (조정 결정 계수) : "/>
                                        <TextBlock Text="{Binding RSquareAdj, UpdateSourceTrigger=PropertyChanged, StringFormat=N4}"/>
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- MAE : "/>
                                        <TextBlock Text="{Binding MAE, UpdateSourceTrigger=PropertyChanged, StringFormat=N4}"/>
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- MSE : "/>
                                        <TextBlock Text="{Binding MSE, UpdateSourceTrigger=PropertyChanged, StringFormat=N4}"/>
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- RMSE : "/>
                                        <TextBlock Text="{Binding RMSE, UpdateSourceTrigger=PropertyChanged, StringFormat=N4}"/>
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- MAPE : "/>
                                        <TextBlock Text="{Binding MAPE, UpdateSourceTrigger=PropertyChanged, StringFormat=N4}"/>
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- MPE : "/>
                                        <TextBlock Text="{Binding MPE, UpdateSourceTrigger=PropertyChanged, StringFormat=N4}"/>
                                    </ui:SimpleStackPanel>
                                </ui:SimpleStackPanel>
                            </ui:ScrollViewerEx>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="1"
                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="5" Padding="5">
                <Grid Margin="5">
                    <Border Grid.Column="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <emoji:TextBlock Grid.Row="0" Text="📊 결과 차트" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                            <TabControl Grid.Row="1">
                                <TabItem Header="실제값 vs 예측값">
                                    <uc:usSingleChartViewer                                         
                                        HorizontalAlignment="Stretch" 
                                        VerticalAlignment="Stretch"
                                        ChartPath="predict_order.png"
                                        ChartName="실제값 vs 예측값"
                                        ChartImage="{Binding PredictOrderImg}"/>
                                </TabItem>
                                <TabItem Header="실제값 vs 예측값(Box Plot)">
                                    <uc:usSingleChartViewer                                         
                                        HorizontalAlignment="Stretch" 
                                        VerticalAlignment="Stretch"
                                        ChartPath="predict_box_img.png"
                                        ChartName="실제값 vs 예측값(Box Plot)"
                                        ChartImage="{Binding PredictBoxImg}"/>
                                </TabItem>
                                <TabItem Header="실제값 vs 예측값(산점도)">
                                    <uc:usSingleChartViewer                                         
                                        HorizontalAlignment="Stretch" 
                                        VerticalAlignment="Stretch"
                                        ChartPath="predict_scatter_img.png"
                                        ChartName="실제값 vs 예측값(산점도)"
                                        ChartImage="{Binding PredictScatterImg}"/>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
