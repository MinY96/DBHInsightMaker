<ui:Page x:Class="DBHTab.Pages.RegModelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:c="clr-namespace:DBHTab.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DBHTab.Pages"
      mc:Ignorable="d" 
      xmlns:ui="http://schemas.modernwpf.com/2019">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
            Style="{StaticResource HeaderTextBlockStyle}" 
            FontSize="35"
            Text="회귀 모형" VerticalAlignment="Center"/>
        <TextBlock x:Name="ModelTypeText"
                   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                   FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,10"/>
        <TextBlock x:Name="EquationText"
                   Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                   TextWrapping="Wrap"
                   FontStyle="Italic"
                   Margin="0,0,0,10"/>
        <Grid Grid.Row="3" Grid.Column="0" Margin="-10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                   Style="{DynamicResource SubtitleTextBlockStyle}"
                   Margin="10,0,0,0" Text="회귀 모델 성과 지표" VerticalAlignment="Center"/>
            <Border Grid.Row="1"
                        Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Margin="10,0,0,0" Padding="10">
                <DataGrid x:Name="PerformanceGrid"
                  Grid.Row="3" Grid.Column="0"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"   
                  CanUserReorderColumns="False"    
                  AlternatingRowBackground="AliceBlue"
                  Margin="0,0,0,10"/>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                   Style="{DynamicResource SubtitleTextBlockStyle}"
                   Margin="10,0,0,0" Text="회귀 계수 통계 검정" VerticalAlignment="Center"/>
            <Border Grid.Row="1"
                        Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Margin="10,0,0,0" Padding="10">
                <DataGrid x:Name="CoefGrid"
                    Grid.Row="3" Grid.Column="1"
                    AutoGenerateColumns="True"
                    IsReadOnly="True"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal"   
                    CanUserReorderColumns="False"    
                    AlternatingRowBackground="AliceBlue"
                    Margin="0,0,10,0"/>
            </Border>
        </Grid>
        <Grid x:Name="grdPlot" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="-10,10,-10,0"/>
    </Grid>
</ui:Page>
