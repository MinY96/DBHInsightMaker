<ui:Page x:Class="DBHTab.Pages.RegSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:c="clr-namespace:DBHTab.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:uc="clr-namespace:DBHTab.UserControls"
      xmlns:local="clr-namespace:DBHTab.Pages"
      mc:Ignorable="d" 
      xmlns:ui="http://schemas.modernwpf.com/2019">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Style="{StaticResource HeaderTextBlockStyle}" 
                   FontSize="35"
                   Text="독립 변수 선택" VerticalAlignment="Center"/>
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                Text="독립 변수 리스트" Style="{DynamicResource SubtitleTextBlockStyle}"/>
            <Border Grid.Row="1"
                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="0,0,0,0" Padding="10">
                <ui:ListView Grid.Row="1"
                        x:Name="IndepVarsList" HorizontalAlignment="Stretch" SelectionMode="Single"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ui:SimpleStackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="10,0,0,0">
                <TextBlock Text="변수 선택 기법: " Style="{DynamicResource SubtitleTextBlockStyle}"/>
                <TextBlock x:Name="SelectionMethodText" Style="{DynamicResource SubtitleTextBlockStyle}" FontWeight="Bold"/>
            </ui:SimpleStackPanel>
            <uc:usSingleChartViewer x:Name="cvHistory"
                                    Grid.Row="1" Margin="0,0,-10,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    ChartName="AIC 변화 History"/>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                   Style="{DynamicResource SubtitleTextBlockStyle}"
                   Margin="10,0,0,0" Text="변수 선택 History" VerticalAlignment="Center"/>
                <Border Grid.Row="1"
                        Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Margin="10,0,0,0" Padding="10">
                    <DataGrid x:Name="SelectionHistGrid"
                              VerticalAlignment="Top" HorizontalAlignment="Stretch"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"   
                              CanUserReorderColumns="False" 
                              AutoGenerateColumns="True" IsReadOnly="True"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:Page>
