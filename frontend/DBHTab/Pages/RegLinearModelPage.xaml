<ui:Page x:Class="DBHTab.Pages.RegLinearModelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:c="clr-namespace:DBHTab.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DBHTab.Pages"
      xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
      xmlns:uc="clr-namespace:DBHTab.UserControls"
      mc:Ignorable="d" 
      xmlns:ui="http://schemas.modernwpf.com/2019">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
            Style="{StaticResource HeaderTextBlockStyle}" 
            FontSize="35" Text="회귀 모형" VerticalAlignment="Center"/>
        <ui:SimpleStackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,0">
            <TextBlock FontSize="18" Text="회귀 모델 타입 : "/>
            <TextBlock FontSize="18" Text="{Binding LinearModelInfo.ModelType, UpdateSourceTrigger=PropertyChanged}"/>
        </ui:SimpleStackPanel>
        <ui:SimpleStackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,0,0">
            <TextBlock FontSize="18" Text="회귀식 : "/>
            <TextBlock FontSize="18" TextWrapping="Wrap" FontStyle="Italic" Text="{Binding LinearModelInfo.RegEquation, UpdateSourceTrigger=PropertyChanged}"/>
        </ui:SimpleStackPanel>
        <Border Grid.Row="3"
            Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Margin="5" Padding="5">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,2,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <emoji:TextBlock Grid.Row="0" Text="📰 회귀 계수 테이블" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                        <DataGrid x:Name="CoefGrid" Grid.Row="1"
                            ItemsSource="{Binding CoefTable}"
                            AutoGenerateColumns="True"
                            IsReadOnly="True"
                            HeadersVisibility="Column" GridLinesVisibility="Horizontal"   
                            CanUserReorderColumns="False"    
                            AlternatingRowBackground="AliceBlue"
                            Margin="0,0,10,0"/>
                    </Grid>
                </Border>
                <Border Grid.Column="1">
                    <Grid Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <emoji:TextBlock Grid.Row="0" Text="📈 모델 적합도 지표"
                                         Style="{DynamicResource SubtitleTextBlockStyle}"/>
                        <ui:ScrollViewerEx Grid.Row="1" VerticalScrollBarVisibility="auto"
                                           VerticalAlignment="Stretch"
                                           HorizontalScrollBarVisibility="Auto">
                            <ui:SimpleStackPanel Spacing="15" Margin="10,0,0,0" DataContext="{Binding LinearModelInfo}">
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- 표본 크기 (n) : "/>
                                    <TextBlock Text="{Binding DataSize, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- 변수 개수 (k) : "/>
                                    <TextBlock Text="{Binding IndepValCount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- LLF (Log-Likelihood Function) : "/>
                                    <TextBlock Text="{Binding LLF, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </ui:SimpleStackPanel>
                            </ui:SimpleStackPanel>
                        </ui:ScrollViewerEx>
                    </Grid>
                </Border>
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="2,0,2,0">
                    <Grid Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <emoji:TextBlock Grid.Row="0" Text="🔍 변동성 및 분산 지표" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                        <ui:ScrollViewerEx Grid.Row="1" VerticalScrollBarVisibility="auto"
                                           VerticalAlignment="Stretch"
                                           HorizontalScrollBarVisibility="Auto">
                            <ui:SimpleStackPanel Spacing="15" Margin="10,0,0,0" DataContext="{Binding LinearModelInfo}">
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- SST (Total Sum of Squares) : "/>
                                    <TextBlock Text="{Binding SST, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- SSR (Regression Sum of Squares) : "/>
                                    <TextBlock Text="{Binding SSR, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- SSE (Error Sum of Squares) : "/>
                                    <TextBlock Text="{Binding SSE, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </ui:SimpleStackPanel>
                            </ui:SimpleStackPanel>
                        </ui:ScrollViewerEx>
                    </Grid>
                </Border>
                <Border Grid.Column="3">
                    <Grid Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <emoji:TextBlock Grid.Row="0" Text="🧠 모델 평가 지표" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                        <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                Background="SkyBlue" BorderBrush="DarkBlue" Width="30" Height="30" Margin="0,-10,0,0"
                                Click="RegDescribe_Button_Click">
                            <emoji:TextBlock Text="❔" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        </Button>
                        <ui:ScrollViewerEx Grid.Row="1" 
                                           VerticalScrollBarVisibility="auto" 
                                           VerticalAlignment="Stretch"
                                           HorizontalScrollBarVisibility="Auto">
                            <ui:SimpleStackPanel Spacing="15" Margin="10,0,0,0" DataContext="{Binding LinearModelInfo}">
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- R² (결정 계수) : "/>
                                    <TextBlock Text="{Binding RSquare, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- R² adj (조정 결정 계수) : "/>
                                    <TextBlock Text="{Binding RSquareAdj, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- F-statistic (F통계량) : "/>
                                    <TextBlock Text="{Binding Statistic, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- p-value : "/>
                                    <TextBlock Text="{Binding PValue, UpdateSourceTrigger=PropertyChanged, StringFormat=E2}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- AIC (Akaike Information Criterion) : "/>
                                    <TextBlock Text="{Binding AIC, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel Orientation="Horizontal">
                                    <TextBlock Text="- BIC (Bayesian Information Criterion) : "/>
                                    <TextBlock Text="{Binding BIC, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </ui:SimpleStackPanel>
                            </ui:SimpleStackPanel>
                        </ui:ScrollViewerEx>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="5" Padding="5">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,2,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <emoji:TextBlock Grid.Row="0" Text="📰 회귀 모델 결과 테이블" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                            <DataGrid x:Name="RegTable" Grid.Row="1"
                                ItemsSource="{Binding RegTable}"
                                AutoGenerateColumns="True"
                                IsReadOnly="True"
                                HeadersVisibility="Column" GridLinesVisibility="Horizontal"   
                                CanUserReorderColumns="False"    
                                AlternatingRowBackground="AliceBlue"
                                Margin="0,0,10,0"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1">
                        <Grid Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <emoji:TextBlock Grid.Row="0" Text="🎯 오차 및 정확도 지표" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                    Background="SkyBlue" BorderBrush="DarkBlue" Width="30" Height="30" Margin="0,-10,0,0"
                                    Click="RegMetrics_Button_Click">
                                <emoji:TextBlock Text="❔" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                            </Button>
                            <ui:ScrollViewerEx Grid.Row="1" VerticalScrollBarVisibility="auto"
                                   VerticalAlignment="Stretch"
                                   HorizontalScrollBarVisibility="Auto">
                                <ui:SimpleStackPanel Spacing="15" Margin="10,0,0,0" DataContext="{Binding LinearModelInfo}">
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- MAE : "/>
                                        <TextBlock Text="{Binding MAE, UpdateSourceTrigger=PropertyChanged, StringFormat=N4}"/>
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- MSE : "/>
                                        <TextBlock Text="{Binding MSE, UpdateSourceTrigger=PropertyChanged, StringFormat=N4}"/>
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- RMSE : "/>
                                        <TextBlock Text="{Binding RMSE, UpdateSourceTrigger=PropertyChanged, StringFormat=N4}"/>
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- MAPE : "/>
                                        <TextBlock Text="{Binding MAPE, UpdateSourceTrigger=PropertyChanged, StringFormat=N4}"/>
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Orientation="Horizontal">
                                        <TextBlock Text="- MPE : "/>
                                        <TextBlock Text="{Binding MPE, UpdateSourceTrigger=PropertyChanged, StringFormat=N4}"/>
                                    </ui:SimpleStackPanel>
                                </ui:SimpleStackPanel>
                            </ui:ScrollViewerEx>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="1"
                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="5" Padding="5">
                <Grid Margin="5">
                    <Border Grid.Column="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <emoji:TextBlock Grid.Row="0" Text="📊 결과 차트" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                            <TabControl Grid.Row="1">
                                <TabItem Header="실제값 vs 예측값">
                                    <uc:usSingleChartViewer                                         
                                        HorizontalAlignment="Stretch" 
                                        VerticalAlignment="Stretch"
                                        ChartPath="predict_order.png"
                                        ChartName="실제값 vs 예측값"
                                        ChartImage="{Binding PredictOrderImg}"/>
                                </TabItem>
                                <TabItem Header="실제값 vs 예측값(Box Plot)">
                                    <uc:usSingleChartViewer                                         
                                        HorizontalAlignment="Stretch" 
                                        VerticalAlignment="Stretch"
                                        ChartPath="predict_box_img.png"
                                        ChartName="실제값 vs 예측값(Box Plot)"
                                        ChartImage="{Binding PredictBoxImg}"/>
                                </TabItem>
                                <TabItem Header="실제값 vs 예측값(산점도)">
                                    <uc:usSingleChartViewer                                         
                                        HorizontalAlignment="Stretch" 
                                        VerticalAlignment="Stretch"
                                        ChartPath="predict_scatter_img.png"
                                        ChartName="실제값 vs 예측값(산점도)"
                                        ChartImage="{Binding PredictScatterImg}"/>
                                </TabItem>
                                <TabItem Header="독립변수 별 회귀식">
                                    <uc:usSingleChartViewer                                         
                                        HorizontalAlignment="Stretch" 
                                        VerticalAlignment="Stretch"
                                        ChartPath="regression_by_indep_var_img.png"
                                        ChartName="독립변수 별 회귀식"
                                        ChartImage="{Binding RegByIndepImg}"/>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:Page>
