<Window x:Class="DBHTab.Views.RegressionAnalysisView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:muxc="http://schemas.modernwpf.com/2019"
        xmlns:c="clr-namespace:DBHTab.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DBHTab.Views" 
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{Binding Path=ProjectName, StringFormat='{}{0} - 회귀 분석', UpdateSourceTrigger=PropertyChanged}"
        mc:Ignorable="d"
        MinHeight="756" MinWidth="1344"
        ResizeMode="CanResizeWithGrip" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Grid>
        <muxc:NavigationView
            x:Name="nvRegressionView"
            PaneTitle="회귀 분석" PaneDisplayMode="Left" IsTabStop="False"
            IsSettingsVisible="False" IsBackButtonVisible="Collapsed"        
            OpenPaneLength="160"
            SelectionChanged="nvRegressionView_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="독립 변수 선택" Tag="1_selection" x:Name="regSelectionPage">
                    <muxc:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Filter"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="독립 변수 검정" Tag="2_corr" x:Name="regCorrPage">
                    <muxc:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Find"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="회귀 모형" Tag="3_model" x:Name="regModelPage">
                    <muxc:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="SolidStar"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="잔차 분석" Tag="4_residual" x:Name="regResidualPage">
                    <muxc:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="FourBars"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="모델 테스트" Tag="5_test" x:Name="regTestPage">
                    <muxc:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Edit"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>
            <ui:Frame x:Name="contentFrameRegression" />
        </muxc:NavigationView>
    </Grid>
</Window>
