<Window x:Class="DBHTab.Views.RelativeChartPopupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:c="clr-namespace:DBHTab.Converters"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DBHTab.Views"
        xmlns:viewmodels="clr-namespace:DBHTab.ViewModels"
        xmlns:uc="clr-namespace:DBHTab.UserControls"
        ui:WindowHelper.UseModernWindowStyle="True"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        Title="{Binding ProjectName, StringFormat='{}{0} 관계 시각화'}"
        MinHeight="540" MinWidth="960"
        Height="540" Width="960">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:SimpleStackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                             Orientation="Horizontal" Margin="10,0,0,0">
            <TextBlock Text="관계 시각화" Style="{StaticResource HeaderTextBlockStyle}" FontSize="35"/>
            <ui:ProgressRing Margin="10,0,0,0"
                Width="30" VerticalAlignment="Stretch"
                IsActive="{Binding IsLoad}" />
            <TextBlock Text="{Binding LoadingMessage, UpdateSourceTrigger=PropertyChanged}"
                        VerticalAlignment="Center" HorizontalAlignment="Left"
                        FontWeight="Light" FontSize="16" Foreground="DeepSkyBlue"/>
        </ui:SimpleStackPanel>
        <ui:SimpleStackPanel Grid.Row="1" Grid.Column="0" Margin="10,0,0,0" Spacing="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <ComboBox
                    ui:ControlHelper.Header="X축 데이터"
                    Grid.Column="0"
                    x:Name="cmbXAxisColumn"
                    HorizontalAlignment="Stretch"
                    ItemTemplate="{StaticResource ColumnComboItem}"
                    SelectedItem="{Binding ColumnXaxis}"
                    ItemsSource="{Binding ColumnLists}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="IsEnabled">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource ComboBoxItemEnabledConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.ColumnXaxis" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.ColumnYaxis" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.ColumnZaxis" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.ColumnGroup" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <Button Grid.Column="1" Content="X" Margin="5,23,0,0" HorizontalAlignment="Stretch" Click="ClearXButton_Click"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <ComboBox
                    ui:ControlHelper.Header="Y축 데이터"
                    Grid.Column="0"
                    x:Name="cmbYAxisColumn"
                    HorizontalAlignment="Stretch"
                    ItemTemplate="{StaticResource ColumnComboItem}"
                    SelectedItem="{Binding ColumnYaxis}"
                    ItemsSource="{Binding ColumnLists}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="IsEnabled">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource ComboBoxItemEnabledConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.ColumnXaxis" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.ColumnYaxis" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.ColumnZaxis" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.ColumnGroup" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <Button Grid.Column="1" Content="X" Margin="5,23,0,0" HorizontalAlignment="Stretch" Click="ClearYButton_Click"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <ComboBox
                    ui:ControlHelper.Header="Z축 데이터"
                    Grid.Column="0"
                    x:Name="cmbZAxisColumn"
                    HorizontalAlignment="Stretch"
                    ItemTemplate="{StaticResource ColumnComboItem}"
                    SelectedItem="{Binding ColumnZaxis}"
                    ItemsSource="{Binding ColumnLists}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="IsEnabled">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource ComboBoxItemEnabledConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.ColumnXaxis" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.ColumnYaxis" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.ColumnZaxis" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.ColumnGroup" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <Button Grid.Column="1" Content="X" Margin="5,23,0,0" HorizontalAlignment="Stretch" Click="ClearZButton_Click"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <ComboBox
                    ui:ControlHelper.Header="Group By"
                    Grid.Column="0"
                    x:Name="cmbGroupColumn"
                    HorizontalAlignment="Stretch"
                    ItemTemplate="{StaticResource ColumnComboItem}"
                    SelectedItem="{Binding ColumnGroup}"
                    ItemsSource="{Binding ColumnLists}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="IsEnabled">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource ComboBoxItemEnabledConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.ColumnXaxis" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.ColumnYaxis" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.ColumnZaxis" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.ColumnGroup" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <Button Grid.Column="1" Content="X" Margin="5,23,0,0" HorizontalAlignment="Stretch" Click="ClearGButton_Click"/>
            </Grid>
            <Button
                x:Name="btnLoadRelativeChart"
                HorizontalAlignment="Stretch"
                Content="관계 시각화"
                FontWeight="Bold" Style="{StaticResource AccentButtonStyle}"
                Command="{Binding LoadRelativeChartCommand}">
                <Button.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiParaConverter}">
                        <Binding Path="ProjectDir"/>
                        <Binding Path="ColumnXaxis"/>
                        <Binding Path="ColumnYaxis"/>
                        <Binding Path="ColumnZaxis"/>
                        <Binding Path="ColumnGroup"/>
                    </MultiBinding>
                </Button.CommandParameter>
            </Button>
        </ui:SimpleStackPanel>
        <uc:ucChartViewer 
            Grid.Row="1" Grid.Column="1" Margin="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ChartInfos="{Binding Charts, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
    </Grid>
</Window>
