<ui:ContentDialog
    x:Class="DBHTab.Views.CreateProjectPopupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:viewmodels="clr-namespace:DBHTab.ViewModels"
    xmlns:local="clr-namespace:DBHTab.Views"
    xmlns:c="clr-namespace:DBHTab.Converters"
    d:DataContext="{d:DesignInstance Type=viewmodels:CreateProjectPopupViewModel}"
    mc:Ignorable="d"
    x:Name="dialogCreateProject"    
    Title="Project 생성"
    PrimaryButtonText="생성"
    PrimaryButtonCommand="{Binding CreateProjectCommand}"
    PrimaryButtonCommandParameter="{Binding Path=ProjectName}"
    IsPrimaryButtonEnabled="{Binding Path=IsProjectName}"
    CloseButtonText="취소"
    DefaultButton="Primary">
    
    <ui:SimpleStackPanel Spacing="12">
        <TextBox 
            ui:ControlHelper.Header="Project 명" 
            PreviewTextInput="TextBox_PreviewTextInput"
            Text="{Binding Path=ProjectName, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox
            HorizontalContentAlignment="Left"
            TextWrapping="Wrap" AcceptsReturn="True"
            Height="120"
            ui:ControlHelper.Header="Project 상세 정보"
            Text="{Binding Path=ProjectDesc, UpdateSourceTrigger=PropertyChanged}"/>

    </ui:SimpleStackPanel>
</ui:ContentDialog>

