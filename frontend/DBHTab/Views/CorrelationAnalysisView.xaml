<Window x:Class="DBHTab.Views.CorrelationAnalysisView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:c="clr-namespace:DBHTab.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:DBHTab.ViewModels"
        xmlns:local="clr-namespace:DBHTab.Views"
        ui:WindowHelper.UseModernWindowStyle="True"
        mc:Ignorable="d"
        Title="{Binding ProjectName, StringFormat='{}{0} 상관분석'}"
        MinHeight="756" MinWidth="1344"
        ResizeMode="CanResizeWithGrip" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="1" Background="LightGray"/>
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="180"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource HeaderTextBlockStyle}"
                       Text="변수 선택" VerticalAlignment="Top" FontSize="35"/>
            <DataGrid 
                Grid.Row="1"
                x:Name="grdCorrVar" Margin="0,0,0,10"
                BorderThickness="1" BorderBrush="LightGray"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"                
                HorizontalContentAlignment="Stretch"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                SelectionUnit="FullRow"
                CanUserAddRows="False"                
                GotFocus="SampleGrid_GotFocused" 
                ItemsSource="{Binding ColumnList}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn
                        Binding="{Binding IsChecked}" Header="선택" CanUserSort="False"/>
                    <DataGridTextColumn
                        IsReadOnly="True" Binding="{Binding Column, UpdateSourceTrigger=PropertyChanged}" Header="변수"/>
                    <DataGridTextColumn
                        IsReadOnly="True" Binding="{Binding ColumnType, Converter={StaticResource ColumnTypeConverter}}" Header="타입"/>
                    <DataGridTextColumn
                        IsReadOnly="True" Binding="{Binding ColumnChar, Converter={StaticResource ColumnCharConverter}}" Header="특성"/>
                </DataGrid.Columns>
            </DataGrid>
            <ui:RadioButtons x:Name="rdoCorrMethod" Grid.Row="2" ui:ControlHelper.Header="상관 계수 Type" MaxColumns="2">
                <RadioButton Content="Pearson" IsChecked="{Binding IsPearson}"/>
                <RadioButton Content="Spearman"/>
            </ui:RadioButtons>
            <TextBlock Grid.Row="3">
                <Run Text="** Pearson(피어슨) 상관계수 (-1 ~ 1)" FontWeight="Bold"/>
                <LineBreak/>
                <Run Text="- 변수 간 선형적 관계"/>
                <LineBreak/>
                <Run Text="- 수치형 변수(이산형, 연속형)에만 적용 가능"/>
                <LineBreak/>
                <Run Text="- 이상치 민감, 정규분포 따를 때 효과적"/>
                <LineBreak/><LineBreak/>
                <Run Text="** Spearman(스피어만) 상관계수 (-1 ~ 1)" FontWeight="Bold"/>
                <LineBreak/>
                <Run Text="- 비모수적 방법, 순위에 대한 상관계수"/>
                <LineBreak/>
                <Run Text="- 순서형 변수도 적용 가능"/>
                <LineBreak/>
                <Run Text="- 이상치에 덜 민감, 정규분포 따를 필요 없음"/>
            </TextBlock>
            <Button 
                Grid.Row="4"
                x:Name="btnAnalyzeCorr"
                Content="상관 분석"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Style="{StaticResource AccentButtonStyle}"
                Command="{Binding LoadCorrelationResultCommand}">
                <Button.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiParaConverter}">
                        <Binding Path="ProjectDir"/>
                        <Binding Path="IsPearson"/>
                        <Binding Path="ColumnList"/>
                    </MultiBinding>
                </Button.CommandParameter>
            </Button>
        </Grid>
        <Grid Grid.Column="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CorrTitle}" Style="{StaticResource HeaderTextBlockStyle}"
                           Width="1000" FontSize="35" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/>
                <ui:ProgressRing Grid.Column="1" Margin="10,0,0,0" Width="30" VerticalAlignment="Center" HorizontalAlignment="Right" IsActive="{Binding IsLoad}" />
                <TextBlock Grid.Column="2" Text="{Binding LoadingMessage, UpdateSourceTrigger=PropertyChanged}"
                        VerticalAlignment="Center" HorizontalAlignment="Left"
                        FontWeight="Light" FontSize="16" Foreground="DeepSkyBlue"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <ui:ScrollViewerEx Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <ui:SimpleStackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ui:SimpleStackPanel Grid.Row="0" HorizontalAlignment="Stretch" Orientation="Horizontal" Spacing="10">
                                <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}"
                                           Margin="10,0,0,0"
                                           Text="{Binding CorrMatrixChartname}" VerticalAlignment="Center"/>
                                <Button VerticalAlignment="Center" Content="차트 저장" 
                                        Command="{Binding SaveChartImageCommand}">
                                    <Button.CommandParameter>
                                        <MultiBinding Converter="{StaticResource MultiParaConverter}">
                                            <Binding Path="CorrMatrixChartname"/>
                                            <Binding Path="CorrMatrixPlot"/>
                                        </MultiBinding>
                                    </Button.CommandParameter>
                                </Button>
                            </ui:SimpleStackPanel>
                            <Border
                                Grid.Row="1"
                                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Margin="10,0,10,0" Padding="10">
                                <Image x:Name="imgCorrMatrix"                                       
                                       Source="{Binding CorrMatrixPlot, Converter={StaticResource NullImageConverter}}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ui:SimpleStackPanel Grid.Row="0" HorizontalAlignment="Stretch" Orientation="Horizontal" Spacing="10">
                                <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}"
                                           Margin="10,0,0,0"
                                           Text="산점도 행렬" VerticalAlignment="Center"/>
                                <Button VerticalAlignment="Center" Content="차트 저장" 
                                        Command="{Binding SaveChartImageCommand}">
                                    <Button.CommandParameter>
                                        <MultiBinding Converter="{StaticResource MultiParaConverter}">
                                            <Binding Path="ScatterMatrixChartName"/>
                                            <Binding Path="ScatterMatrixPlot"/>
                                        </MultiBinding>
                                    </Button.CommandParameter>
                                </Button>
                            </ui:SimpleStackPanel>
                            <Border
                                Grid.Row="1"
                                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Margin="10,0,10,0" Padding="10">
                                <Image x:Name="imgScatterMatrix" 
                                       Source="{Binding ScatterMatrixPlot, Converter={StaticResource NullImageConverter}}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                            </Border>
                        </Grid>
                    </ui:SimpleStackPanel>
                </ui:ScrollViewerEx>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Style="{DynamicResource SubtitleTextBlockStyle}"
                                   Margin="10,0,0,0" Text="상관 계수 상세" VerticalAlignment="Center"/>
                        <Border
                            Grid.Row="1"
                            Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Margin="10,0,10,0" Padding="10">
                            <DataGrid 
                                x:Name="grdCorrResult"
                                BorderThickness="1" BorderBrush="LightGray"
                                AutoGenerateColumns="False"
                                CanUserReorderColumns="False"                
                                HorizontalContentAlignment="Stretch"
                                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                ItemsSource="{Binding CorrResult}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        IsReadOnly="True" Binding="{Binding Column1}" Header="표본 1"/>
                                    <DataGridTextColumn
                                        IsReadOnly="True" Binding="{Binding Column2}" Header="표본 2"/>
                                    <DataGridTextColumn
                                        IsReadOnly="True" Binding="{Binding SampleCount, StringFormat=N0}" Header="N"/>
                                    <DataGridTextColumn
                                        IsReadOnly="True" Binding="{Binding Coefficient, StringFormat=N3}" Header="상관계수(ρ)"/>
                                    <DataGridTemplateColumn IsReadOnly="True" Header="ρ에 대한 95% 신뢰구간">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Margin="5,0,0,0">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}({0:N3}, {1:N3})">
                                                            <Binding Path="ConfidenceIntervalLower"/>
                                                            <Binding Path="ConfidenceIntervalUpper"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn
                                        IsReadOnly="True" Binding="{Binding PValue, StringFormat=N3}" Header="p-value"/>
                                    <DataGridTextColumn
                                        IsReadOnly="True" Binding="{Binding CorrelationLevel}" Header="상관 관계" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                    Style="{DynamicResource SubtitleTextBlockStyle}" Margin="10,0,0,0" Text="상관 분석 해석" VerticalAlignment="Center"/>
                        <Border Grid.Row="1" Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" Padding="5" Margin="10,-10,0,10" CornerRadius="5">
                            <ui:ScrollViewerEx VerticalScrollBarVisibility="Auto">
                                <ui:SimpleStackPanel Spacing="10">
                                    <TextBlock Text="상관계수(ρ) 에 대한 해석" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Margin="10,0,0,0" HorizontalAlignment="Left">
                                        <Italic>-1.0 ≤ ρ ＜ -0.7</Italic>
                                        <Run Text=" : 강한 음의 상관 관계"/>
                                        <LineBreak/>                                    
                                        <Italic>-0.7 ≤ ρ ＜ -0.3</Italic>                                    
                                        <Run Text=" : 약한 음의 상관 관계"/>
                                        <LineBreak/>
                                        <Italic>-0.3 ≤ ρ ＜ 0.3</Italic>
                                        <Run Text="  : 상관 관계 없음"/>
                                        <LineBreak/>
                                        <Italic>0.3 ≤ ρ ＜ 0.7</Italic>
                                        <Run Text="   : 약한 양의 상관 관계"/>
                                        <LineBreak/>
                                        <Italic>0.7 ≤ ρ ≤ 1.0</Italic>
                                        <Run Text="    : 강한 양의 상관 관계"/>
                                    </TextBlock>
                                    <TextBlock Text="** 상관 계수는 두 변수 간의 관계를 나타내지만, 이 관계가 인과적이지 않을 수 있습니다." TextWrapping="Wrap" FontStyle="Italic" Margin="5"/>
                                    <TextBlock Text="** 상관 계수는 선형 관계만을 측정합니다. 두 변수 간에 비선형 관계가 있을 경우, 상관 계수는 낮게 나올 수 있지만 여전히 강한 관계가 존재할 수 있습니다. (산점도 확인 필수)" TextWrapping="Wrap" FontStyle="Italic" Margin="5"/>
                                    <TextBlock Text="** 유의미한 샘플 수 : 일반적으로 30개 이상" TextWrapping="Wrap" FontStyle="Italic" Margin="5"/>
                                </ui:SimpleStackPanel>
                            </ui:ScrollViewerEx>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Padding="5" Margin="10,-10,10,10" CornerRadius="5">
                            <ui:ScrollViewerEx VerticalScrollBarVisibility="Auto">
                                <ui:SimpleStackPanel Spacing="10">
                                    <TextBlock Text="p-value 에 대한 해석" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="상관 관계가 통계적으로 유의한지 확인." Margin="5,0,0,0"/>
                                    <TextBlock Margin="5,-10,0,0">
                                        <Run Text="p-value는"/>
                                        <Bold>우연히 이런 상관계수를 얻었을 가능성</Bold>
                                        <Run Text="을 의미"/>
                                    </TextBlock>
                                    <TextBlock Margin="10,0,0,0" HorizontalAlignment="Left" TextWrapping="Wrap">
                                        <Italic>H0 (귀무 가설)</Italic>
                                        <Italic>: "두 변수 간에 상관 관계가 없다" (ρ = 0)</Italic>
                                        <LineBreak/>                                    
                                        <Italic>H1 (대립 가설)</Italic>                                    
                                        <Italic> : "두 변수 간에 상관 관계가 있다" (ρ ≠ 0)</Italic>
                                    </TextBlock>
                                    <TextBlock Margin="5" TextWrapping="Wrap">
                                        <Bold>p-value ≤ 0.05(α): 상관 계수가 통계적으로 유의함 (H0 기각)</Bold>
                                    </TextBlock>
                                    <TextBlock Text="p-value가 유의 수준보다 작거나 같으면 귀무 가설을 기각합니다. 상관 계수가 통계적으로 유의하다는 결론을 내릴 수 있습니다."
                                               Margin="10,-10,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Margin="5,0,0,0" TextWrapping="Wrap">
                                        <Bold>p-value ＞ 0.05(α): 상관 계수가 통계적으로 유의하지 않음</Bold>
                                    </TextBlock>
                                    <TextBlock Text="p-value가 유의 수준보다 크면 귀무 가설을 기각할 수 없습니다. 상관 계수가 통계적으로 유의하다는 결론을 내릴 충분한 근거가 없습니다." Margin="10,-10,0,0" TextWrapping="Wrap"/>
                                </ui:SimpleStackPanel>
                            </ui:ScrollViewerEx>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
