<Window x:Class="DBHTab.Views.CustomChartView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:c="clr-namespace:DBHTab.Converters"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfx="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cs="clr-namespace:DBHTab.Models"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:uc="clr-namespace:DBHTab.UserControls"
        xmlns:local="clr-namespace:DBHTab.Views"
        ui:WindowHelper.UseModernWindowStyle="True"
        mc:Ignorable="d"
        Title="{Binding ProjectName, StringFormat='{}{0} - 차트 커스텀'}"
        MinHeight="756" MinWidth="1500"
        ResizeMode="CanResizeWithGrip" WindowState="Maximized" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- TextBox 템플릿 -->
        <DataTemplate x:Key="TextBoxOptionTemplate">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="{Binding Name}" Width="210" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
            </StackPanel>
        </DataTemplate>
        <!-- ComboBox 템플릿 -->
        <DataTemplate x:Key="ComboBoxOptionTemplate">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="{Binding Name}" Width="210" VerticalAlignment="Center" Padding="{Binding ControlPadding}"/>
                <ComboBox ItemsSource="{Binding Option}"                          
                          SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="250" />
            </StackPanel>
        </DataTemplate>
        <!-- CheckBox 템플릿 -->
        <DataTemplate x:Key="CheckBoxOptionTemplate">
            <StackPanel Orientation="Horizontal" Margin="5">
                <CheckBox Content="{Binding Name}" IsThreeState="False"
                          IsChecked="{Binding Value, Converter={StaticResource ChartOptionStringToNullableBoolConverter}}"/>
            </StackPanel>
        </DataTemplate>
        <!-- IntegerUpDown 템플릿 -->
        <DataTemplate x:Key="IntegerUpDownOptionTemplate">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="{Binding Name}" Width="210" VerticalAlignment="Center"/>
                <wpfx:IntegerUpDown Width="250" Minimum="{Binding Min}" Maximum="{Binding Max}"
                                    FormatString="N0" Increment="1"
                                    Value="{Binding Value, Converter={StaticResource ChartOptionStringToNullableIntConverter}}"/>
            </StackPanel>
        </DataTemplate>
        <!-- DoubleUpDown 템플릿 -->
        <DataTemplate x:Key="DoubleUpDownOptionTemplate">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="{Binding Name}" Width="210" VerticalAlignment="Center"/>
                <wpfx:DoubleUpDown Width="250"
                                    FormatString="F4" Increment="1" Minimum="{Binding MinDouble}" Maximum="{Binding MaxDouble}"
                                    Value="{Binding Value, Converter={StaticResource ChartOptionStringToNullableDoubleConverter}}"/>
            </StackPanel>
        </DataTemplate>
        <!-- DateTimePicker 템플릿 -->
        <DataTemplate x:Key="DateTimePickerOptionTemplate">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="{Binding Name}" Width="210" VerticalAlignment="Center"/>
                <wpfx:DateTimePicker Width="250"
                                     Format="Custom" FormatString="yyyy-MM-dd HH:mm:ss"
                                     Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,
                                            Converter={StaticResource ChartOptionStringToDateTimeConverter},
                                            ConverterParameter='yyyy-MM-dd HH:mm:ss'}"/>
            </StackPanel>
        </DataTemplate>
        <!-- ColorPicker 템플릿 -->
        <DataTemplate x:Key="ColorPickerOptionTemplate">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="{Binding Name}" Width="210" VerticalAlignment="Center" Padding="{Binding ControlPadding}"/>
                <wpfx:ColorPicker Width="250" SelectedColor="{Binding Value, Converter={StaticResource ChartOptionStringToColorConverter}}"/>
            </StackPanel>
        </DataTemplate>
        <!-- 수직/수평선 추가 옵션 템플릿 -->
        <DataTemplate x:Key="LinesChartOptionTemplate">
            <StackPanel Orientation="Horizontal" Margin="5">
                <uc:LinesOption Width="450" VerticalAlignment="Center" Lines="{Binding LinesOption, Mode=TwoWay}"/>
            </StackPanel>
        </DataTemplate>
        <!-- y 컬럼 추가 옵션 템플릿 -->
        <DataTemplate x:Key="AddColumnOptionTemplate">
            <StackPanel Orientation="Horizontal" Margin="5">
                <uc:AddColumnOption Width="450" VerticalAlignment="Center"
                                    AddedColumns="{Binding AddedColumnOptions, Mode=TwoWay}" Columns="{Binding Option}"/>
            </StackPanel>
        </DataTemplate>
        <cs:OptionTemplateSelector x:Key="OptionTemplaceSelector"
                                   ComboBoxTemplate="{StaticResource ComboBoxOptionTemplate}"
                                   CheckBoxTemplate="{StaticResource CheckBoxOptionTemplate}"
                                   IntegerUpDownTemplate="{StaticResource IntegerUpDownOptionTemplate}"
                                   DoubleUpDownTemplate="{StaticResource DoubleUpDownOptionTemplate}"
                                   DateTimePickerTemplate="{StaticResource DateTimePickerOptionTemplate}"
                                   ColorPickerTemplate="{StaticResource ColorPickerOptionTemplate}"
                                   TextBoxTemplate="{StaticResource TextBoxOptionTemplate}"
                                   LinesTemplate ="{StaticResource LinesChartOptionTemplate }"
                                   AddColumnTemplate="{StaticResource AddColumnOptionTemplate}"/>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Margin="5,5,5,5" Padding="5"
                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="300"/>
                </Grid.RowDefinitions>
                <emoji:TextBlock Grid.Row="0" Text="📰 지원 차트" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                <TreeView x:Name="tvChart" Grid.Row="1"
                          ItemsSource="{Binding ChartNodes}"
                          Background="LightGray"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectedItemChanged">
                            <i:InvokeCommandAction
                                Command="{Binding TreeItemSelectedCommand}"
                                CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Header}"/>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <emoji:TextBlock Grid.Row="2" Text="🔖 차트 샘플" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                <Image Grid.Row="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"                       
                       Source="{Binding SampleChart}" Stretch="Uniform"/>
            </Grid>
        </Border>
        <Border Grid.Column="1"
                Margin="0,5,5,5"
                Padding="5"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1">
            <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <emoji:TextBlock Grid.Row="0" Text="{Binding SelectedChartHeader, StringFormat={}📊 {0}}" Style="{DynamicResource SubtitleTextBlockStyle}"/>
                <TextBlock Grid.Row="1" Margin="15,5,0,0"
                           Text="{Binding SelectedChartDesc}"/>
                <Grid Grid.Row="2" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="500"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <emoji:TextBlock Grid.Row="0" Grid.Column="0"
                                     Text="⚙ 차트 생성 옵션" 
                                     VerticalAlignment="Center"
                                     Style="{DynamicResource SubtitleTextBlockStyle}"/>
                    <Border Grid.Row="1" Grid.Column="0" 
                            Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}" Margin="3">
                        <Grid>
                            <ui:ScrollViewerEx VerticalScrollBarVisibility="Auto"
                                               Margin="10,0,0,0"
                                               IsEnabled="{Binding IsLoadingOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding Options}"
                                              ItemTemplateSelector="{StaticResource OptionTemplaceSelector}"/>
                            </ui:ScrollViewerEx>
                            <Grid Background="#80FFFFFF" Visibility="{Binding IsLoadingOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                                    <TextBlock Text="옵션을 불러오는 중입니다..."
                                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="150" Height="15"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding DisabledReason}"
                               FontStyle="Italic" Foreground="Red" HorizontalAlignment="Right"/>
                    <Button 
                        x:Name="btnCreateCustomChart"
                        Grid.Row="3" Grid.Column="0"
                        Margin="2"
                        Content="차트 생성"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding LoadCustomChartCommand}">
                        <Button.CommandParameter>
                            <MultiBinding Converter="{StaticResource MultiParaConverter}">
                                <Binding Path="ProjectDir"/>
                                <Binding Path="SelectedChartGroup"/>
                                <Binding Path="SelectedChartType"/>
                                <Binding Path="Options"/>
                                <Binding Path="IsCreatingChart"/>
                            </MultiBinding>
                        </Button.CommandParameter>
                    </Button>
                    <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="3">
                        <uc:usSingleChartViewer 
                            Margin="-5,0,-8,2"
                            IsEnabled="{Binding IsCreatingChart, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch"
                            ChartPath="{Binding CustomChartPath}"
                            ChartName="생성 차트"
                            ChartImage="{Binding CreationChart}"/>
                        <Grid Background="#80FFFFFF" Visibility="{Binding IsCreatingChart, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                                <TextBlock Text="차트 생성 중입니다..." HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <ProgressBar IsIndeterminate="True" Width="150" Height="15"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
