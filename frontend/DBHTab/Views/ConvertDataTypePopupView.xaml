<Window x:Class="DBHTab.Views.ConvertDataTypePopupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:c="clr-namespace:DBHTab.Converters"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:DBHTab.ViewModels"
        xmlns:local="clr-namespace:DBHTab.Views"
        ui:WindowHelper.UseModernWindowStyle="True"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        Title="{Binding ColumnName, StringFormat='{}{0} 데이터 Type 변경'}"
        MinHeight="540" MinWidth="960"
        Height="540" Width="960">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <ui:SimpleStackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                     Orientation="Horizontal" Margin="10,0,0,0">
            <TextBlock Text="데이터 Type 변경" Style="{StaticResource HeaderTextBlockStyle}" FontSize="35"/>
            <ui:ProgressRing Margin="10,0,0,0" Width="30" VerticalAlignment="Stretch" IsActive="{Binding IsLoad}" />
            <TextBlock Text="{Binding LoadingMessage, UpdateSourceTrigger=PropertyChanged}"
                VerticalAlignment="Center" HorizontalAlignment="Left"
                FontWeight="Light" FontSize="16" Foreground="DeepSkyBlue"/>
        </ui:SimpleStackPanel>
        <ui:SimpleStackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="10,0,0,0" Orientation="Horizontal" Spacing="10">
            <ui:SimpleStackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="데이터:"/>
                <TextBlock x:Name="txtColumnName" Margin="3,0,0,0" Text="{Binding ColumnName}"/>
            </ui:SimpleStackPanel>
            <ui:SimpleStackPanel Grid.Row="1" Orientation="Horizontal">
                <TextBlock Text="Type:"/>
                <TextBlock Margin="3,0,0,0" Text="{Binding ColumnChar, Converter={StaticResource ColumnCharConverter}}"/>
                <TextBlock Text="{Binding ColumnChar, StringFormat='({0})'}"/>
            </ui:SimpleStackPanel>
        </ui:SimpleStackPanel>
        <Grid Grid.Column="0" Grid.Row="2" Margin="10" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding ColumnName, StringFormat='{}변경 전 {0} - Initial 50'}"
                       Style="{StaticResource HeaderTextBlockStyle}" FontSize="20" VerticalAlignment="Top" Margin="0,0,0,0"/>
            <DataGrid 
                x:Name="grdBefore"
                Grid.Row="1"                
                BorderThickness="1" BorderBrush="LightGray"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"                
                HorizontalContentAlignment="Stretch"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                HeadersVisibility="Row" GridLinesVisibility="Horizontal"
                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                ItemsSource="{Binding BeforeData}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        IsReadOnly="True" Binding="{Binding}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid Grid.Column="2" Grid.Row="2" Margin="10" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding ColumnName, StringFormat='{}변경 후 {0} - Initial 50'}"
                       Style="{StaticResource HeaderTextBlockStyle}" FontSize="20" VerticalAlignment="Top" Margin="0,0,0,0"/>
            <DataGrid 
                x:Name="grdAfter"
                Grid.Row="1"                
                BorderThickness="1" BorderBrush="LightGray"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"                
                HorizontalContentAlignment="Stretch"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                HeadersVisibility="Row" GridLinesVisibility="Horizontal"
                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                ItemsSource="{Binding AfterData}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        IsReadOnly="True" Binding="{Binding}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <ui:SimpleStackPanel Grid.Row="2" Grid.Column="1" Margin="10" Spacing="12">
            <TextBlock Text="Convert To" Style="{StaticResource HeaderTextBlockStyle}" FontSize="20"/>
            <Button x:Name="btnConvertToContinuous"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{Binding EnableContinuous}"
                    HorizontalAlignment="Stretch" Content="연속형"
                    Click="ConvertType_Click"/>
            <Button x:Name="btnConvertToDiscrete"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{Binding EnableDiscrete}"
                    HorizontalAlignment="Stretch" Content="이산형"
                    Click="ConvertType_Click"/>
            <Button x:Name="btnConvertToDateTime"                    
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{Binding EnableDateTime}"
                    HorizontalAlignment="Stretch" Content="DateTime"
                    Click="ConvertToDateTime_Click"/>
            <Button x:Name="btnConvertToNominal"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{Binding EnableNominal}"
                    HorizontalAlignment="Stretch" Content="명목형"
                    Click="ConvertType_Click"/>
            <Button x:Name="btnConvertToOrdinal"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{Binding EnableOrdinal}"
                    HorizontalAlignment="Stretch" Content="순서형"
                    Click="ConvertToOrdinal_Click"/>
        </ui:SimpleStackPanel>
        <Button x:Name="btnApplyConvertedType"
                Grid.Row="3" Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="80"
                Margin="0,0,10,10"
                Style="{StaticResource AccentButtonStyle}"
                Command="{Binding ConvertDataTypeCommand}"
                CommandParameter="{Binding Path=SaveMode}"
                Content="저장"/>
    </Grid>
</Window>
