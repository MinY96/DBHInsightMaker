<Window x:Class="DBHTab.Views.NormalityTestPopupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:c="clr-namespace:DBHTab.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DBHTab.Views"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        WindowStartupLocation="CenterOwner"
        MinWidth="700" MinHeight="848"
        Height="848" Width="700"
        Title="{Binding ColumnName, StringFormat='{}{0} 정규성 검정'}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="360"/>
        </Grid.RowDefinitions>
        <ui:SimpleStackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="{Binding ColumnName, StringFormat='{}{0} 정규성 검정'}"
                       Style="{StaticResource HeaderTextBlockStyle}"
                       FontSize="35" Margin="10,0,0,0"/>
            <ui:ProgressRing Margin="10,0,0,0"
                             Width="30" VerticalAlignment="Stretch"
                             IsActive="{Binding IsLoad}" />
            <TextBlock Text="{Binding LoadingMessage, UpdateSourceTrigger=PropertyChanged}"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       FontWeight="Light" FontSize="16" Foreground="DeepSkyBlue"/>
        </ui:SimpleStackPanel>
        <Border
            Grid.Row="1"
            Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" Margin="10,0,10,0">
            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="15" Margin="10"
                                 VerticalAlignment="Center">
                <ui:SimpleStackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="평균:" FontSize="15"/>
                    <TextBlock Text="{Binding Mean, StringFormat=N2}" FontSize="15"/>
                </ui:SimpleStackPanel>
                <ui:SimpleStackPanel Orientation="Horizontal">
                    <TextBlock Text="표준편차:" FontSize="15"/>
                    <TextBlock Text="{Binding Std, StringFormat=N2}" FontSize="15"/>
                </ui:SimpleStackPanel>
                <ui:SimpleStackPanel Orientation="Horizontal">
                    <TextBlock Text="N:" FontSize="15"/>
                    <TextBlock Text="{Binding DataCount, StringFormat=N0}" FontSize="15"/>
                </ui:SimpleStackPanel>
            </ui:SimpleStackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ui:SimpleStackPanel 
                Grid.Row="0" Grid.Column="0"
                HorizontalAlignment="Center"
                Orientation="Horizontal" Spacing="10">
                <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}"
                           Text="QQ Plot" VerticalAlignment="Center"/>
                <Button
                    VerticalAlignment="Center"
                    Content="차트 저장"
                    Command="{Binding SaveChartImageCommand}">
                    <Button.CommandParameter>
                        <MultiBinding Converter="{StaticResource MultiParaConverter}">
                            <Binding Path="QQPlotChartName"/>
                            <Binding Path="QQPlot"/>
                        </MultiBinding>
                    </Button.CommandParameter>
                </Button>
            </ui:SimpleStackPanel>
            <ui:SimpleStackPanel 
                Grid.Row="0" Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal" Spacing="10">
                <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}"
                           Text="분포" VerticalAlignment="Center"/>
                <Button
                    VerticalAlignment="Center"
                    Content="차트 저장"
                    Command="{Binding SaveChartImageCommand}">
                    <Button.CommandParameter>
                        <MultiBinding Converter="{StaticResource MultiParaConverter}">
                            <Binding Path="DistPlotChartName"/>
                            <Binding Path="DistPlot"/>
                        </MultiBinding>
                    </Button.CommandParameter>
                </Button>
            </ui:SimpleStackPanel>
            <Image x:Name="imgQQPlot" 
                   Grid.Row="1" Grid.Column="0"
                   Source="{Binding QQPlot, Converter={StaticResource NullImageConverter}}"
                   HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
            <Image x:Name="imgDistPlot"                   
                   Grid.Row="1" Grid.Column="1"
                   Source="{Binding DistPlot, Converter={StaticResource NullImageConverter}}"
                   HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
        </Grid>
        <Grid Grid.Row="3" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock 
                Grid.Row="0"
                Style="{DynamicResource SubtitleTextBlockStyle}"
                Text="정규성 검정 기법"
                VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            <Grid 
                Grid.Row="1" Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <ui:RadioButtons
                    Grid.Column="0"
                    x:Name="rdoNormalityTestMethod" MaxColumns="3"
                    
                    SelectedIndex="{Binding SelectedMethodIndex}"
                    SelectionChanged="NormalityMethod_Changed">
                    <RadioButton Content="Shapiro-Wilk" Margin="0,0,0,0"/>
                    <RadioButton Content="Kolmogorov-Smirnov" Margin="-25,0,0,0"/>
                    <RadioButton Content="Anderson-Darling" Margin="0"/>
                </ui:RadioButtons>
                <ui:SimpleStackPanel 
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal" Spacing="5" Margin="0,0,0,0">
                    <TextBlock Text="유의수준 ( α ) :" VerticalAlignment="Center"/>
                    <ComboBox
                        x:Name="cmbSignificanceLevel"
                        SelectionChanged="cmbSignificanceLevel_SelectionChanged"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Right">
                        <ComboBoxItem Content="0.05" IsSelected="True" HorizontalContentAlignment="Right"/>
                        <ComboBoxItem Content="0.01" HorizontalContentAlignment="Right"/>
                    </ComboBox>
                </ui:SimpleStackPanel>
            </Grid>
            <Border
                Grid.Row="2"
                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="10,0,10,0">
                <ui:SimpleStackPanel>
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="5" Margin="10,10,0,10">
                        <TextBlock Text="추천 케이스 :" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BestCase}" VerticalAlignment="Center"/>
                    </ui:SimpleStackPanel>
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="5" Margin="10,0,0,10">
                        <TextBlock Text="강점 :" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Strength}" VerticalAlignment="Center"/>
                    </ui:SimpleStackPanel>
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="5" Margin="10,0,0,10">
                        <TextBlock Text="약점 :" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Weakness}" VerticalAlignment="Center"/>
                    </ui:SimpleStackPanel>
                    <Border
                        Background="Transparent" BorderBrush="Orange" BorderThickness="2"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Margin="5">
                        <ui:SimpleStackPanel>
                            <TextBlock Text="귀무가설(H0): 데이터가 정규분포를 따른다."
                                       FontStyle="Italic" FontWeight="Bold" HorizontalAlignment="Stretch" Margin="10,10,0,10"/>
                            <TextBlock Text="대립가설(H1): 데이터가 정규분포를 따르지 않는다." 
                                       FontStyle="Italic" FontWeight="Bold" HorizontalAlignment="Stretch" Margin="10,0,0,10"/>
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="5" Margin="10,10,0,10">
                                <TextBlock Text="검정 결과 :" VerticalAlignment="Center" FontSize="20"/>
                                <TextBlock Text="{Binding Result}" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                            </ui:SimpleStackPanel>
                            <TextBlock Text="{Binding Detail}" HorizontalAlignment="Stretch" Margin="15,0,0,10"/>
                        </ui:SimpleStackPanel>
                    </Border>
                </ui:SimpleStackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
